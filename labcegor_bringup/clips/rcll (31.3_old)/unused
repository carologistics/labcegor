(defrule instructCS-21
  ?instructCS-f <- (instructCS ?oid ?capColor)
  ?robot-f <- (robot (name ROBOT1) (currentOrder ?oid))
  ?machineWaitingForInstruction-f <- (machineWaitingForInstruction M-CS) 
  ?machine-f <- (machine (name M-CS) (state IDLE))

  (protobuf-peer (name refbox-private) (peer-id ?peer-id))
  (not (waitingFor (machine M-CS) (orderID ?oid)))
=>

  (bind ?msg (pb-create "llsf_msgs.PrepareMachine"))
  (pb-set-field ?msg "team_color" MAGENTA)
  (pb-set-field ?msg "machine" M-CS)
  

  (bind ?msgPrepare (pb-create "llsf_msgs.PrepareInstructionCS"))
  ;(pb-set-field ?msgPrepare "side" "OUTPUT")
  (pb-set-field ?msgPrepare "cap_color" ?capColor)
  (pb-set-field ?msg "instruction_cs" ?msgPrepare)

  (pb-broadcast ?peer-id ?msg)
 
  (pb-destroy ?msg)
  (assert (waitingFor (machine M-CS) (orderID ?oid)))
  (printout green "instruct CS" crlf)  
  (retract ?instructCS-f)
  (retract ?machineWaitingForInstruction-f)
  

)
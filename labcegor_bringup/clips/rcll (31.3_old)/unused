(defrule startOrder
  ?order-f <- (order (id ?oid) (base-color ?base) (complexity ?c) (ring-colors $?ringColors))
  (not (order-tasks (orderID ?oid)))
  ?ringsToProduce-f <- (ringsToProduce (blue ?b) (green ?g) (yellow ?y) (orange ?o))
  (not (order-tasks (orderID ?oid)))
  ?ringsToProduce-f <- (ringsToProduce (blue ?b) (green ?g) (yellow ?y) (orange ?o))
;wie multislot handhaben? ringsToProduce anpassen, dann weiter mit ringStationTasks
=> 
  (switch ?c
  (case "0" then 
    (assert (order-tasks (orderID ?oid)
                        (complexity ?c)
                        (product-to-ring-1 TRUE) 
                        (place-product-1 TRUE)
                        (instruct-ring-1 TRUE)
                        (robot-to-output-1 TRUE)
                        (get-product-1 TRUE)    
                        (product-to-ring-2 TRUE) 
                        (place-product-2 TRUE)
                        (instruct-ring-2 TRUE)
                        (robot-to-output-2 TRUE)
                        (get-product-2 TRUE)    
                        (product-to-ring-3 TRUE) 
                        (place-product-3 TRUE)
                        (instruct-ring-3 TRUE)
                        (robot-to-output-3 TRUE)
                        (get-product-3 TRUE))
    )   
  )
  (case "1" then 
    (assert (order-tasks (orderID ?oid)
                        (complexity ?c)
                        (product-to-ring-2 TRUE) 
                        (place-product-2 TRUE)
                        (instruct-ring-2 TRUE)
                        (robot-to-output-2 TRUE)
                        (get-product-2 TRUE)    
                        (product-to-ring-3 TRUE) 
                        (place-product-3 TRUE)
                        (instruct-ring-3 TRUE)
                        (robot-to-output-3 TRUE)
                        (get-product-3 TRUE))
    )    
    (bind ?firstItem (nth$ 1 ?ringColors))
    (if (eq ?firstItem BLUE) then (modify ?ringsToProduce-f (blue (+ ?b 1))))  
    (if (eq ?firstItem GREEN) then (modify ?ringsToProduce-f (green (+ ?b 1))))  
    (if (eq ?firstItem YELLOW) then (modify ?ringsToProduce-f (yellow (+ ?b 1))))
    (if (eq ?firstItem ORANGE) then (modify ?ringsToProduce-f (orange (+ ?b 1))))  
  )
  (case "2" then 
    (assert (order-tasks (orderID ?oid)
                        (complexity ?c)
                        (product-to-ring-3 TRUE) 
                        (place-product-3 TRUE)
                        (instruct-ring-3 TRUE)
                        (robot-to-output-3 TRUE)
                        (get-product-3 TRUE))
    ) 
    (bind ?firstItem (nth$ 1 ?ringColors))
    (bind ?secondItem (nth$ 2 ?ringColors))
    (if (eq ?firstItem BLUE) then (modify ?ringsToProduce-f (blue (+ ?b 1))))  
    (if (eq ?firstItem GREEN) then (modify ?ringsToProduce-f (green (+ ?b 1))))  
    (if (eq ?firstItem YELLOW) then (modify ?ringsToProduce-f (yellow (+ ?b 1))))  
    (if (eq ?firstItem ORANGE) then (modify ?ringsToProduce-f (orange (+ ?b 1)))) 
    (if (eq ?secondItem BLUE) then (modify ?ringsToProduce-f (blue (+ ?b 1))))  
    (if (eq ?secondItem GREEN) then (modify ?ringsToProduce-f (green (+ ?b 1))))  
    (if (eq ?secondItem YELLOW) then (modify ?ringsToProduce-f (yellow (+ ?b 1))))  
    (if (eq ?secondItem ORANGE) then (modify ?ringsToProduce-f (orange (+ ?b 1))))     
  )
  (case "3" then 
    (assert (order-tasks (orderID ?oid) (complexity ?c))) 
    (bind ?firstItem (nth$ 1 ?ringColors))
    (bind ?secondItem (nth$ 2 ?ringColors))
    (bind ?thirdItem (nth$ 3 ?ringColors))
    (if (eq ?firstItem BLUE) then (modify ?ringsToProduce-f (blue (+ ?b 1))))  
    (if (eq ?firstItem GREEN) then (modify ?ringsToProduce-f (green (+ ?b 1))))  
    (if (eq ?firstItem YELLOW) then (modify ?ringsToProduce-f (yellow (+ ?b 1))))  
    (if (eq ?firstItem ORANGE) then (modify ?ringsToProduce-f (orange (+ ?b 1)))) 
    (if (eq ?secondItem BLUE) then (modify ?ringsToProduce-f (blue (+ ?b 1))))  
    (if (eq ?secondItem GREEN) then (modify ?ringsToProduce-f (green (+ ?b 1))))  
    (if (eq ?secondItem YELLOW) then (modify ?ringsToProduce-f (yellow (+ ?b 1))))  
    (if (eq ?secondItem ORANGE) then (modify ?ringsToProduce-f (orange (+ ?b 1))))   
    (if (eq ?thirdItem BLUE) then (modify ?ringsToProduce-f (blue (+ ?b 1)))) 
    (if (eq ?thirdItem GREEN) then (modify ?ringsToProduce-f (green (+ ?b 1))))  
    (if (eq ?thirdItem YELLOW) then (modify ?ringsToProduce-f (yellow (+ ?b 1))))  
    (if (eq ?thirdItem ORANGE) then (modify ?ringsToProduce-f (orange (+ ?b 1))))       
  )
  (default none)
  )    
  
)

